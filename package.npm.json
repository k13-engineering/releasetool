    "releasetool": "dist/bin/releasetool.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {},
  "repository": {
    "type": "git",
    "url": "git+https://github.com/k13-engineering/releasetool.git"
  },
  "keywords": [
    "typescript",
    "build",
    "type-stripping",
    "declarations",
    "npm",
    "release",
    "ts-blank-space"
  ],
