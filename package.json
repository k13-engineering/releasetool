{
  "type": "module",
  "bin": {
    "releasetool": "./bin/releasetool.ts"
  },
  "main": "lib/index.ts",
  "scripts": {
    "build": "rm -rf dist/ && node bin/releasetool.ts build --root . --out dist/ --entry lib/index.ts --entry bin/releasetool.ts",
    "type-check": "tsc --noEmit",
    "test": "c8 --100 --reporter lcov --reporter html --reporter text --all --src lib/ --exclude 'lib/**/*.spec.ts' mocha 'lib/**/*.spec.ts'",
    "lint": "eslint .",
    "update-deps": "npm-check-updates -u --reject typescript && npm-check-updates -u --target minor --filter typescript"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@k13engineering/eslint-rules": "^0.0.6",
    "@k13engineering/releasetool": "^0.0.6",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.4",
    "@types/yargs": "^17.0.33",
    "c8": "^12.0.0",
    "mocha": "^12.0.3",
    "npm-check-updates": "^23.1.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "ts-blank-space": "^0.9.0",
    "typescript": "^6.0.3",
    "yargs": "^17.7.2"
  }
}
